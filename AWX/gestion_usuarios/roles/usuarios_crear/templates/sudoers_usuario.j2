# Gestionado por Ansible (gestion_usuarios). NO editar manualmente.
# Usuario: {{ item.usuario }} | Perfil: {{ item.perfil }} - {{ perfiles[item.perfil].descripcion | default('') }}
{% if not (item.sudo_nopasswd | bool) %}
# sudo pide la contraseña del propio usuario (SUSE por defecto pediría la de root).
Defaults:{{ item.usuario }} !targetpw, !rootpw
{% endif %}
{% if item.sudo_efectivo == 'completo' %}
{{ item.usuario }} ALL=({{ crear_sudo_runas }}) {{ 'NOPASSWD: ' if (item.sudo_nopasswd | bool) else '' }}ALL
{% else %}
{{ item.usuario }} ALL=({{ crear_sudo_runas }}) {{ 'NOPASSWD: ' if (item.sudo_nopasswd | bool) else '' }}\
    {{ item.sudo_resueltos | join(', \\\n    ') }}
{% endif %}
