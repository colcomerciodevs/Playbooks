<!doctype html>
{%- set rango = {'CRITICO': 0, 'ALTO': 1, 'MEDIO': 2, 'BAJO': 3, 'INFO': 4} %}
{%- set ok = [] %}{% set ko = [] %}
{%- for h in aud_hosts %}{% if (hostvars[h]['auditoria_resultado'] | default({})).usuarios is defined %}{% set _ = ok.append(h) %}{% else %}{% set _ = ko.append(h) %}{% endif %}{% endfor %}
{%- set t = {'u': 0, 'c': 0, 'l': 0, 'n': 0, 'acc': 0} %}
{%- set hall = [] %}
{%- set sudos = [] %}
{%- for h in ok %}
{%-   set r = hostvars[h]['auditoria_resultado'] %}
{%-   set _ = t.update({'u': t.u + r.resumen.usuarios, 'c': t.c + r.resumen.sudo_completo, 'l': t.l + r.resumen.sudo_limitado, 'n': t.n + r.resumen.sudo_sin_clave, 'acc': t.acc + r.resumen.pueden_iniciar_sesion}) %}
{%-   for x in r.hallazgos_servidor %}{% set _ = hall.append({'r': rango[x.severidad], 'sev': x.severidad, 'host': h, 'usuario': '(servidor)', 'codigo': x.codigo, 'detalle': x.detalle}) %}{% endfor %}
{%-   for u in r.usuarios %}
{%-     for x in u.hallazgos %}{% set _ = hall.append({'r': rango[x.severidad], 'sev': x.severidad, 'host': h, 'usuario': u.usuario, 'codigo': x.codigo, 'detalle': x.detalle}) %}{% endfor %}
{%-     if u.sudo.nivel in ['COMPLETO', 'LIMITADO'] %}{% set _ = sudos.append({'host': h, 'u': u}) %}{% endif %}
{%-   endfor %}
{%- endfor %}
{%- set conteo = {} %}
{%- for s in ['CRITICO', 'ALTO', 'MEDIO', 'BAJO', 'INFO'] %}{% set _ = conteo.update({s: hall | selectattr('sev', 'equalto', s) | list | length}) %}{% endfor %}
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Auditoría de usuarios {{ aud_fecha }}</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--tx:#1d2330;--mut:#5d6677;--bd:#dfe3ea;--hd:#eef1f5;--acc:#2456c7;
--crit:#b3261e;--crit-bg:#fde8e6;--alto:#b15c00;--alto-bg:#fff0de;--medio:#8a6d00;--medio-bg:#fff8d6;--bajo:#2f6b3a;--bajo-bg:#e6f4e8;--info:#46556b;--info-bg:#eaeef4}
@media (prefers-color-scheme:dark){:root{--bg:#14171c;--card:#1c2027;--tx:#e6e9ef;--mut:#9aa3b2;--bd:#2d333d;--hd:#232832;--acc:#8fb0ff;
--crit:#ff8a80;--crit-bg:#3a1714;--alto:#ffb35c;--alto-bg:#382511;--medio:#f0d264;--medio-bg:#332c0e;--bajo:#8fd19b;--bajo-bg:#16301b;--info:#b4c0d3;--info-bg:#232a35}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1400px;margin:0 auto;padding:24px 16px 64px}
h1{font-size:24px;margin:0 0 4px}h2{font-size:18px;margin:32px 0 10px}p.meta{color:var(--mut);margin:0 0 20px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.kpi{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:12px 14px}
.kpi b{display:block;font-size:24px;font-variant-numeric:tabular-nums}.kpi span{color:var(--mut);font-size:12.5px}
.kpi.crit b{color:var(--crit)}.kpi.alto b{color:var(--alto)}
.tool{display:flex;gap:8px;align-items:center;margin:8px 0;flex-wrap:wrap}
input[type=search]{flex:1;min-width:200px;padding:8px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--tx);font:inherit}
.wrap{overflow-x:auto;background:var(--card);border:1px solid var(--bd);border-radius:10px}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:7px 10px;border-bottom:1px solid var(--bd);text-align:left;vertical-align:top}
th{background:var(--hd);position:sticky;top:0;font-weight:600;white-space:nowrap}
tr:last-child td{border-bottom:0}td.n{font-variant-numeric:tabular-nums;text-align:right}
code{font:12px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;word-break:break-all}
code.cod{word-break:normal;white-space:nowrap}
.sev{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:600;white-space:nowrap}
.CRITICO{color:var(--crit);background:var(--crit-bg)}.ALTO{color:var(--alto);background:var(--alto-bg)}
.MEDIO{color:var(--medio);background:var(--medio-bg)}.BAJO{color:var(--bajo);background:var(--bajo-bg)}.INFO{color:var(--info);background:var(--info-bg)}
.COMPLETO{color:var(--crit);font-weight:600}.LIMITADO{color:var(--alto);font-weight:600}.NINGUNO{color:var(--mut)}
.riesgo{color:var(--crit)}
details{background:var(--card);border:1px solid var(--bd);border-radius:10px;margin:8px 0}
summary{cursor:pointer;padding:10px 14px;font-weight:600}summary small{font-weight:400;color:var(--mut);margin-left:8px}
details .wrap{border:0;border-top:1px solid var(--bd);border-radius:0 0 10px 10px}
.box{padding:8px 14px;color:var(--mut);font-size:13px}
.nota{color:var(--mut);font-size:12.5px;margin-top:6px}
@media print{input,.tool{display:none}details{break-inside:avoid}details:not([open]) .wrap{display:block}}
</style>
</head>
<body>
<main>
<h1>Auditoría de usuarios y privilegios sudo</h1>
<p class="meta">Generado: {{ aud_fecha }} · Objetivo: <b>{{ objetivo | default('-') | e }}</b> · Cuentas con UID ≥ {{ auditoria_uid_minimo }} · Fuente: /etc/passwd, /etc/shadow, sudo -ll -U, sshd -T</p>

<div class="kpis">
  <div class="kpi"><b>{{ ok | length }}</b><span>servidores auditados</span></div>
  <div class="kpi{{ ' alto' if ko else '' }}"><b>{{ ko | length }}</b><span>no alcanzados / fallidos</span></div>
  <div class="kpi"><b>{{ t.u }}</b><span>cuentas (UID ≥ {{ auditoria_uid_minimo }})</span></div>
  <div class="kpi"><b>{{ t.acc }}</b><span>pueden iniciar sesión</span></div>
  <div class="kpi"><b>{{ t.c }}</b><span>con sudo completo</span></div>
  <div class="kpi"><b>{{ t.l }}</b><span>con sudo limitado</span></div>
  <div class="kpi"><b>{{ t.n }}</b><span>sudo sin contraseña</span></div>
  <div class="kpi crit"><b>{{ conteo.CRITICO }}</b><span>hallazgos críticos</span></div>
  <div class="kpi alto"><b>{{ conteo.ALTO }}</b><span>hallazgos altos</span></div>
</div>

<h2>Hallazgos ({{ hall | length }})</h2>
<div class="tool"><input type="search" placeholder="Filtrar hallazgos por servidor, usuario o texto…" data-tabla="t-hall"></div>
<div class="wrap"><table id="t-hall">
<thead><tr><th>Severidad</th><th>Servidor</th><th>Usuario</th><th>Código</th><th>Detalle</th></tr></thead>
<tbody>
{%- for x in hall | sort(attribute='r') %}
<tr><td><span class="sev {{ x.sev }}">{{ x.sev }}</span></td><td>{{ x.host | e }}</td><td>{{ x.usuario | e }}</td><td><code class="cod">{{ x.codigo }}</code></td><td>{{ x.detalle | e }}</td></tr>
{%- else %}
<tr><td colspan="5">Sin hallazgos.</td></tr>
{%- endfor %}
</tbody></table></div>

<h2>Cuentas con privilegios sudo ({{ sudos | length }})</h2>
<div class="tool"><input type="search" placeholder="Filtrar por servidor, usuario o comando…" data-tabla="t-sudo"></div>
<div class="wrap"><table id="t-sudo">
<thead><tr><th>Servidor</th><th>Usuario</th><th>Nombre</th><th>Nivel</th><th>Sin clave</th><th>Clave exigida</th><th>Comandos permitidos</th><th>Origen de la regla</th></tr></thead>
<tbody>
{%- for s in sudos %}{% set u = s.u %}
<tr><td>{{ s.host | e }}</td><td><b>{{ u.usuario | e }}</b></td><td>{{ u.nombre | e }}</td>
<td class="{{ u.sudo.nivel }}">{{ u.sudo.nivel }}</td><td>{{ 'SÍ' if u.sudo.nopasswd else 'no' }}</td><td>{{ u.sudo.requiere_clave | default('', true) | e }}</td>
<td>{% for cmd in u.sudo.comandos %}<code class="{{ 'riesgo' if cmd in u.sudo.comandos_riesgo else '' }}">{{ cmd | e }}</code>{{ '' if loop.last else ', ' }}{% endfor %}</td>
<td>{% for o in (u.sudo.origenes + (u.sudo.fuentes_locales | default([]))) | unique %}<code>{{ o | e }}</code><br>{% endfor %}</td></tr>
{%- else %}
<tr><td colspan="8">Ninguna cuenta con UID ≥ {{ auditoria_uid_minimo }} tiene sudo.</td></tr>
{%- endfor %}
</tbody></table></div>
<p class="nota">En rojo: comandos que permiten obtener una shell de root (shells, editores, paginadores como less/journalctl/systemctl status, intérpretes; ver GTFOBins). "Clave exigida = root (targetpw)" indica que sudo pide la contraseña de root, típico de SUSE.</p>

<h2>Detalle por servidor</h2>
<div class="tool"><input type="search" placeholder="Filtrar en todas las tablas de servidores…" data-grupo="srv"></div>
{%- for h in ok %}{% set r = hostvars[h]['auditoria_resultado'] %}
<details data-srv>
<summary>{{ h | e }}<small>{{ r.servidor.sistema | e }} · {{ r.resumen.usuarios }} cuentas · sudo completo {{ r.resumen.sudo_completo }} · limitado {{ r.resumen.sudo_limitado }}{% if r.resumen.hallazgos_critico %} · <span class="sev CRITICO">{{ r.resumen.hallazgos_critico }} crítico(s)</span>{% endif %}{% if r.resumen.hallazgos_alto %} · <span class="sev ALTO">{{ r.resumen.hallazgos_alto }} alto(s)</span>{% endif %}</small></summary>
<div class="box">root: contraseña {{ r.servidor.root.estado_contrasena | default('?') }}, último cambio {{ r.servidor.root.ultimo_cambio | default('?') }}, caduca <b>{{ r.servidor.root.contrasena_caduca | default('?') }}</b>
{%- if r.servidor.cuentas_uid0 | length > 1 %} · <span class="sev CRITICO">UID 0: {{ r.servidor.cuentas_uid0 | map(attribute='usuario') | join(', ') }}</span>{% endif %}
 · {{ r.servidor.sudo_version | default('sudo no instalado', true) | e }}{% if r.servidor.sudo_clave_destino %} · Defaults {{ r.servidor.sudo_clave_destino | join(', ') }}{% endif %}
{%- if r.servidor.sshd.allowgroups is defined %} · AllowGroups: {{ r.servidor.sshd.allowgroups | join(' ') | e }}{% endif %}
{%- if r.servidor.sshd.allowusers is defined %} · AllowUsers: {{ r.servidor.sshd.allowusers | join(' ') | e }}{% endif %}
{%- if r.servidor.sshd.permitrootlogin is defined %} · PermitRootLogin: {{ r.servidor.sshd.permitrootlogin }}{% endif %}</div>
<div class="wrap"><table>
<thead><tr><th>Usuario</th><th>UID</th><th>Nombre</th><th>Grupos</th><th>Acceso</th><th>Contraseña</th><th>Último cambio</th><th>Caduca</th><th>Cuenta expira</th><th>Llaves</th><th>Último acceso</th><th>Sudo</th><th>Hallazgos</th></tr></thead>
<tbody>
{%- for u in r.usuarios %}
<tr><td><b>{{ u.usuario | e }}</b></td><td class="n">{{ u.uid }}</td><td>{{ u.nombre | e }}</td>
<td>{{ ([u.grupo_primario] + u.grupos_secundarios) | join(', ') | e }}</td>
<td>{{ 'Sí' if u.puede_iniciar_sesion else 'No' }}{% if not u.ssh_permitido %} <small>(SSH: {{ u.ssh_motivo | e }})</small>{% elif not u.shell_interactivo %} <small>({{ u.shell | e }})</small>{% endif %}</td>
<td>{{ u.estado_contrasena }}{% if u.algoritmo_hash %} <small>{{ u.algoritmo_hash }}</small>{% endif %}</td>
<td>{{ u.ultimo_cambio }}</td><td>{{ u.contrasena_caduca }}{{ ' (vencida)' if u.contrasena_expirada else '' }}</td><td>{{ u.cuenta_expira }}</td>
<td class="n" title="{{ u.llaves_ssh | map(attribute='comentario') | join(', ') | e }}">{{ u.llaves_ssh | length }}</td>
<td>{{ u.ultimo_acceso | e }}</td>
<td class="{{ u.sudo.nivel }}">{{ u.sudo.nivel }}{{ ' · NOPASSWD' if u.sudo.nopasswd else '' }}</td>
<td>{% for x in u.hallazgos %}<span class="sev {{ x.severidad }}" title="{{ x.detalle | e }}">{{ x.codigo }}</span> {% endfor %}</td></tr>
{%- else %}
<tr><td colspan="13">Sin cuentas con UID ≥ {{ auditoria_uid_minimo }}.</td></tr>
{%- endfor %}
</tbody></table></div>
</details>
{%- endfor %}

{%- if ko %}
<h2>Servidores no alcanzados o con error ({{ ko | length }})</h2>
<div class="wrap"><table><thead><tr><th>Servidor</th><th>Motivo</th></tr></thead><tbody>
{%- for h in ko %}<tr><td>{{ h | e }}</td><td>{{ (hostvars[h]['auditoria_resultado'] | default({})).msg | default('No respondió (inalcanzable o fallo de autenticación/become antes de auditar).') | e }}</td></tr>{% endfor %}
</tbody></table></div>
{%- endif %}
</main>
<script>
document.querySelectorAll('input[type=search]').forEach(function (inp) {
  inp.addEventListener('input', function () {
    var q = inp.value.toLowerCase();
    var tablas = inp.dataset.tabla ? [document.getElementById(inp.dataset.tabla)]
      : Array.prototype.slice.call(document.querySelectorAll('details[data-srv] table'));
    tablas.forEach(function (t) {
      t.querySelectorAll('tbody tr').forEach(function (tr) {
        tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
      });
    });
    if (!inp.dataset.tabla) {
      document.querySelectorAll('details[data-srv]').forEach(function (d) {
        var visible = d.textContent.toLowerCase().indexOf(q) > -1;
        d.style.display = !q || visible ? '' : 'none';
        if (q && visible) d.open = true;
      });
    }
  });
});
</script>
</body>
</html>
