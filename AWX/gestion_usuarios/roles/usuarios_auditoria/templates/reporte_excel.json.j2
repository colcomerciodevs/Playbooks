{#- Contenido del Excel de auditoría (lo escribe el módulo generar_excel).
    Hojas: Resumen, Tipos de hallazgo, Usuarios, Plan forzar cambio contraseña, Servidores, Sudo, Hallazgos, Detalle y,
    en la verificación de un workflow, No encontradas.
    Explicaciones de cada tipo de hallazgo: roles/usuarios_auditoria/vars/main.yml -#}
{%- set rango = {'CRITICO': 0, 'ALTO': 1, 'MEDIO': 2, 'BAJO': 3, 'INFO': 4} %}
{%- set sev_txt = {'CRITICO': 'CRÍTICO', 'ALTO': 'ALTO', 'MEDIO': 'MEDIO', 'BAJO': 'BAJO', 'INFO': 'INFO', '': '-'} %}
{%- set sev_color = {'CRÍTICO': 'rojo', 'ALTO': 'naranja', 'MEDIO': 'amarillo', 'BAJO': 'azul', 'INFO': 'gris'} %}
{%- set nivel_txt = {'COMPLETO': 'Total (ALL)', 'LIMITADO': 'Limitado', 'NINGUNO': 'Sin sudo'} %}
{%- set motivo_exp = [
      ['Cuenta crítica', 'root, tux y las demás cuentas administradoras protegidas (cuentas_criticas).'],
      ['Cuenta de sistema', 'UID por debajo del mínimo: son cuentas del sistema operativo.'],
      ['UID especial', 'UID reservado (nobody y similares).'],
      ['Cuenta de servicio', 'Está en la lista cuentas_servicio: la usan aplicaciones, no personas.'],
      ['Shell no interactivo', 'No puede abrir una terminal; no tiene sentido pedirle cambio.'],
      ['Cuenta expirada', 'Está deshabilitada por fecha y no puede entrar: el cambio no tendría efecto.'],
      ['Contraseña bloqueada', 'Tiene contraseña, pero bloqueada: no se puede usar para entrar.'],
      ['Sin contraseña: solo llave', 'Entra solo con llave SSH; forzar el cambio le quitaría el acceso.'],
      ['Sin contraseña', 'No tiene contraseña ni llave: no puede entrar.'],
      ['Contraseña vacía', 'Se corrige asignando contraseña con la opción 2, no forzando el cambio.'],
      ['Cambio forzado ya pendiente', 'Ya debe cambiarla en su próximo ingreso: forzarlo otra vez no cambiaría nada. Si nunca entra, evalúe bloquearla o eliminarla (opción 4).'],
      ['Sin registro en /etc/shadow', 'No se pudo leer su contraseña.'],
    ] %}
{%- set ok = [] %}{% set ko = [] %}
{%- for h in aud_hosts %}{% if (hostvars[h]['auditoria_resultado'] | default({})).usuarios is defined %}{% set _ = ok.append(h) %}{% else %}{% set _ = ko.append(h) %}{% endif %}{% endfor %}
{%- set hn = {} %}{% for h in ok %}{% set _ = hn.update({h: hostvars[h]['auditoria_resultado'].servidor.hostname | default('')}) %}{% endfor %}
{#- t: totales.  srv: conteos por servidor (sudo calculado desde cada cuenta para que cuadre con Detalle). -#}
{%- set t = {'u': 0, 'acc': 0, 'tot': 0, 'np': 0, 'pr': 0, 'rt': 0, 'lim': 0, 'fz': 0} %}
{%- set srv = {} %}{% set motivos = {} %}
{%- set hall = [] %}{% set tipos = {} %}{% set sudos = [] %}{% set detalle = [] %}{% set porusu = {} %}{% set noenc = [] %}
{%- for h in ok %}
{%-   set r = hostvars[h]['auditoria_resultado'] %}
{%-   set ip = aud_ip[h] | default('') %}
{%-   set c = {'tot': 0, 'np': 0, 'pr': 0, 'rt': 0, 'lim': 0, 'fz': 0} %}
{%-   for x in r.hallazgos_servidor %}
{%-     set _ = hall.append([rango[x.severidad], sev_txt[x.severidad], h, '(servidor)', x.codigo, x.detalle, hn[h], ip]) %}
{%-     set k = x.severidad ~ '|' ~ x.codigo %}{% set e = tipos.setdefault(k, {'casos': 0, 'srv': {}, 'cta': {}}) %}
{%-     set _ = e.update({'casos': e.casos + 1}) %}{% set _ = e.srv.update({h: 1}) %}
{%-   endfor %}
{%-   for u in r.no_encontrados | default([]) %}{% set _ = noenc.append([h, u, hn[h], ip]) %}{% endfor %}
{%-   for u in r.usuarios %}
{%-     set motivo = '' if u.forzaria_cambio else u.motivo_no_forzar | default('No aplica', true) %}
{%-     set estado = u.estado_detalle | default(u.estado_contrasena) %}
{%-     set nivel = u.sudo.nivel %}
{%-     set pide = '' if nivel == 'NINGUNO' else ('Ninguna (NOPASSWD)' if u.sudo.nopasswd else
          ('La de root' ~ ((u.sudo.requiere_clave | default(''))[4:]) if (u.sudo.requiere_clave | default('')).startswith('root')
           else ('La propia' if u.sudo.requiere_clave | default('') in ['', 'propia'] else u.sudo.requiere_clave))) %}
{%-     if nivel == 'COMPLETO' %}
{%-       set clase = 'np' if u.sudo.nopasswd else ('rt' if (u.sudo.requiere_clave | default('')).startswith('root') else 'pr') %}
{%-       set _ = c.update({'tot': c.tot + 1, clase: c[clase] + 1}) %}
{%-     elif nivel == 'LIMITADO' %}{% set _ = c.update({'lim': c.lim + 1}) %}
{%-     endif %}
{%-     if u.forzaria_cambio %}{% set _ = c.update({'fz': c.fz + 1}) %}
{%-     else %}{% set _ = motivos.update({motivo: motivos.get(motivo, 0) + 1}) %}{% endif %}
{%-     for x in u.hallazgos %}
{%-       set _ = hall.append([rango[x.severidad], sev_txt[x.severidad], h, u.usuario, x.codigo, x.detalle, hn[h], ip]) %}
{%-       set k = x.severidad ~ '|' ~ x.codigo %}{% set e = tipos.setdefault(k, {'casos': 0, 'srv': {}, 'cta': {}}) %}
{%-       set _ = e.update({'casos': e.casos + 1}) %}{% set _ = e.srv.update({h: 1}) %}{% set _ = e.cta.update({u.usuario: 1}) %}
{%-     endfor %}
{%-     if nivel in ['COMPLETO', 'LIMITADO'] %}
{%-       set _ = sudos.append([h, u.usuario, u.nombre, nivel_txt[nivel], pide, u.sudo.comandos | join(' , '), u.sudo.comandos_riesgo | join(' , '),
            (u.sudo.origenes + (u.sudo.fuentes_locales | default([]))) | unique | join(' | '), hn[h], ip]) %}
{%-     endif %}
{%-     set _ = detalle.append([h, u.usuario, u.nombre, u.uid, sev_txt[u.severidad_max | default('')], u.hallazgos | map(attribute='detalle') | join(' | '),
          'SÍ' if u.puede_iniciar_sesion else 'NO', 'SÍ' if u.ssh_permitido else 'NO: ' ~ u.ssh_motivo, estado,
          'SÍ' if u.forzaria_cambio else 'NO', motivo,
          nivel_txt[nivel], pide, u.ultimo_acceso, u.dias_sin_acceso, u.ultimo_cambio, u.contrasena_caduca, 'SÍ' if u.contrasena_expirada else 'NO', u.cuenta_expira,
          u.llaves_ssh | length, u.algoritmo_hash, u.shell, u.grupo_primario, u.grupos_secundarios | join(', '), hn[h], ip, r.servidor.sistema]) %}
{%-     set acceso = u.ultimo_acceso if (u.ultimo_acceso | default('') | string) is match('[0-9]{4}-') else '' %}
{%-     set e = porusu.setdefault(u.usuario, {'nombres': [], 'n': 0, 'login': 0, 'ult': '', 'estados': {}, 'grupos': {}, 'sev': 9, 'tot': 0, 'np': 0}) %}
{%-     if u.nombre and u.nombre | trim not in e.nombres %}{% set _ = e.nombres.append(u.nombre | trim) %}{% endif %}
{%-     set _ = e.update({'n': e.n + 1, 'login': e.login + (1 if u.puede_iniciar_sesion else 0), 'ult': [e.ult, acceso] | max,
          'sev': [e.sev, rango.get(u.severidad_max | default(''), 9)] | min}) %}
{%-     if nivel == 'COMPLETO' %}{% set _ = e.update({'tot': e.tot + 1, 'np': e.np + (1 if u.sudo.nopasswd else 0)}) %}{% endif %}
{%-     set d = estado | regex_replace(' desde [0-9-]+', '') %}{% set _ = e.estados.update({d: e.estados.get(d, 0) + 1}) %}
{#-     Grupo del plan: misma decisión y mismo motivo (todos los SÍ del usuario van en una sola fila) -#}
{%-     set g = e.grupos.setdefault(('SÍ' if u.forzaria_cambio else 'NO') ~ '|' ~ motivo, {'srv': [], 'est': {}, 'llave': 0, 'ult': ''}) %}
{%-     set _ = g.srv.append(h) %}{% set _ = g.est.update({d: g.est.get(d, 0) + 1}) %}
{%-     set _ = g.update({'llave': g.llave + (1 if u.llaves_ssh | length else 0), 'ult': [g.ult, acceso] | max}) %}
{%-   endfor %}
{%-   set _ = srv.update({h: c}) %}
{%-   set _ = t.update({'u': t.u + r.usuarios | length, 'acc': t.acc + r.resumen.pueden_iniciar_sesion, 'tot': t.tot + c.tot, 'np': t.np + c.np,
        'pr': t.pr + c.pr, 'rt': t.rt + c.rt, 'lim': t.lim + c.lim, 'fz': t.fz + c.fz}) %}
{%- endfor %}
{%- set sev_por_rango = ['CRÍTICO', 'ALTO', 'MEDIO', 'BAJO', 'INFO'] %}
{#- ---------------------------------------------------------------- Usuarios y Plan forzar cambio contraseña -#}
{%- set REVISAR = 'REVISAR: posible cuenta de servicio, aplicación o compartida' %}
{%- set CONFIRMAR = 'CONFIRMAR: cuenta sin descripción' %}
{%- set APLICAR = 'APLICAR: cuenta personal' %}
{%- set EXCLUIDA = 'EXCLUIDA: el sistema la omite' %}
{%- set CORREGIR = 'CORREGIR: asignar contraseña (opción 2)' %}
{%- set ind = auditoria_indicios_servicio %}
{%- set usuarios = [] %}{% set plan = [] %}{% set rec_cuenta = {} %}
{%- for nombre in porusu | sort %}{% set e = porusu[nombre] %}
{%-   set desc = e.nombres | join(' / ') %}
{%-   set estados_txt = [] %}{% for m in e.estados | dictsort(by='value') | reverse %}{% set _ = estados_txt.append(m[0] ~ ' (' ~ m[1] ~ (' servidor)' if m[1] == 1 else ' servidores)')) %}{% endfor %}
{%-   set _ = usuarios.append([nombre, desc or '-', e.n, e.login, e.ult or 'Nunca', sev_por_rango[e.sev] if e.sev < 9 else '-', e.tot, e.np, estados_txt | join('; ')]) %}
{#-   Indicios propios del usuario (valen para todos sus servidores) -#}
{%-   set fuertes = [] %}{% set debiles = [] %}
{%-   if nombre is search(ind.nombre_generico, ignorecase=True) %}{% set _ = fuertes.append('Nombre genérico o de aplicación') %}{% endif %}
{%-   if nombre is search(ind.nombre_con_numero) %}{% set _ = fuertes.append('Nombre terminado en número (cuenta de puesto o compartida)') %}{% endif %}
{%-   if desc and desc is search(ind.descripcion_servicio, ignorecase=True) %}{% set _ = fuertes.append('La descripción habla de un servicio o de un uso genérico') %}{% endif %}
{%-   if not desc %}{% set _ = debiles.append('Sin descripción (nombre completo vacío)') %}{% endif %}
{#-   Plan: primero la fila SÍ y luego las de NO, de más a menos servidores -#}
{%-   set grupos = [] %}{% for k in e.grupos %}{% set _ = grupos.append([0 if k.startswith('SÍ') else 1, 100000 - e.grupos[k].srv | length, k]) %}{% endfor %}
{%-   for x in grupos | sort %}{% set p = x[2].split('|') %}{% set g = e.grupos[x[2]] %}
{%-     set est = [] %}{% for m in g.est | dictsort(by='value') | reverse %}{% set _ = est.append(m[0] ~ ' (' ~ m[1] ~ ')') %}{% endfor %}
{%-     if p[0] == 'SÍ' %}
{%-       set indicios = fuertes + debiles + (['Usa llave SSH en ' ~ g.llave ~ ' de estos servidores: si la usa un proceso automático, el cambio forzado lo interrumpiría'] if g.llave else []) %}
{%-       set rec = REVISAR if (fuertes or g.llave) else (CONFIRMAR if debiles else APLICAR) %}
{%-       set just = 'Tiene contraseña activa, terminal interactiva y no está en ninguna lista de excepción, así que el cambio masivo la incluye.'
                   ~ ('' if rec == APLICAR else ' Si no es de una persona, agréguela a cuentas_servicio (vars/comunes.yml) antes del cambio masivo.') %}
{%-     else %}
{%-       set indicios = fuertes + debiles %}
{%-       set exp = [] %}{% for q in motivo_exp if p[1].startswith(q[0]) and not exp %}{% set _ = exp.append(q[1]) %}{% endfor %}
{%-       set rec = CORREGIR if p[1].startswith('Contraseña vacía') else EXCLUIDA %}
{%-       set just = p[1] ~ ': ' ~ (exp | first | default('')) %}
{%-     endif %}
{%-     set _ = rec_cuenta.update({rec: rec_cuenta.get(rec, 0) + g.srv | length}) %}
{%-     set _ = plan.append([nombre, desc or '-', rec, p[0], just, indicios | join('; ') or '-', est | join('; '), g.ult or 'Nunca', g.srv | length, g.srv | join(', ')]) %}
{%-   endfor %}
{%- endfor %}
{%- set rec_usuarios = {} %}{% for x in plan %}{% set _ = rec_usuarios.setdefault(x[2], {}).update({x[0]: 1}) %}{% endfor %}
{#- ---------------------------------------------------------------- Servidores -#}
{%- set servidores = [] %}
{%- for h in aud_hosts %}{% set r = hostvars[h]['auditoria_resultado'] | default({}) %}
{%-   if h in ok %}{% set s = r.servidor %}{% set m = r.resumen %}{% set c = srv[h] %}
{%-     set _ = servidores.append([h, s.hostname | default(''), aud_ip[h] | default(''), 'OK', s.sistema, r.usuarios | length, m.pueden_iniciar_sesion,
          c.tot, c.np, c.pr, c.rt, c.lim, c.fz, m.hallazgos_critico, m.hallazgos_alto,
          s.root.estado_contrasena | default(''), s.root.ultimo_cambio | default(''), s.root.contrasena_caduca | default(''),
          s.cuentas_uid0 | map(attribute='usuario') | join(', '), s.sudo_version | default('sudo no instalado', true), s.sudo_clave_destino | join(', '),
          (s.sshd.allowusers | default([])) | join(' '), (s.sshd.allowgroups | default([])) | join(' '), s.sshd.permitrootlogin | default(''), '']) %}
{%-   else %}
{%-     set _ = servidores.append([h, '', aud_ip[h] | default(''), 'SIN RESPUESTA', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '',
          r.msg | default('No respondió (apagado, inalcanzable o fallo de autenticación/become antes de auditar).')]) %}
{%-   endif %}
{%- endfor %}
{#- ---------------------------------------------------------------- Tipos de hallazgo -#}
{%- set tipos_filas = [] %}{% set conteo = {'CRITICO': 0, 'ALTO': 0, 'MEDIO': 0, 'BAJO': 0, 'INFO': 0} %}
{%- for k in tipos %}{% set sev = k.split('|')[0] %}{% set cod = k.split('|')[1] %}{% set e = tipos[k] %}
{%-   set _ = conteo.update({sev: conteo[sev] + e.casos}) %}
{%-   set info = auditoria_tipos_hallazgo[cod] | default({'que': '', 'accion': ''}) %}
{%-   set _ = tipos_filas.append([rango[sev], 100000000 - e.casos, sev_txt[sev], cod, info.que, info.accion, e.casos, e.srv | length, (e.cta | length) if e.cta else '-']) %}
{%- endfor %}
{%- set tipos_filas = tipos_filas | sort %}
{#- ---------------------------------------------------------------- Resumen -#}
{%- set res = [] %}{% set res_est = {} %}
{%- set titulo = ('Verificación del cambio: ' ~ (cambio_operacion | default('-'))) if aud_cambio | bool else 'Auditoría de usuarios y privilegios sudo' %}
{%- set _ = res_est.update({'0': 'titulo'}) %}{% set _ = res.append([titulo, '', '']) %}
{%- set _ = res.append(['Generado', aud_fecha, '']) %}
{%- set _ = res.append(['Objetivo', objetivo | default('-'), '']) %}
{%- set _ = res.append(['Alcance', ('Solo las cuentas modificadas por el workflow' if aud_cambio | bool else 'Cuentas de personas y aplicaciones (UID ' ~ auditoria_uid_minimo ~ ' o mayor)'), '']) %}
{%- if aud_cambio | bool %}{% set _ = res.append(['Ticket', ticket_cambio | default('-'), '']) %}{% endif %}
{%- set _ = res.append(['', '', '']) %}
{%- set _ = res_est.update({res | length | string: 'seccion'}) %}{% set _ = res.append(['1. Cobertura', 'Cantidad', 'Qué significa']) %}
{%- set _ = res.append(['Servidores auditados', ok | length, 'Respondieron y se revisaron.']) %}
{%- set _ = res.append(['Servidores sin respuesta', ko | length, ('No se pudieron revisar (apagados, sin acceso o con error). Aparecen en la hoja Servidores con Estado = SIN RESPUESTA y no suman en las demás cifras.' if ko else 'Todos los servidores respondieron.')]) %}
{%- set _ = res.append(['Cuentas revisadas', t.u, 'Una por cuenta y servidor: la misma persona en 10 servidores cuenta 10 veces (hoja Detalle).']) %}
{%- set _ = res.append(['Usuarios distintos', porusu | length, 'Nombres de usuario únicos (hoja Usuarios).']) %}
{%- set _ = res.append(['Pueden iniciar sesión', t.acc, 'Tienen terminal, contraseña o llave utilizable, la cuenta no está expirada y SSH las permite.']) %}
{%- set _ = res.append(['', '', '']) %}
{%- set _ = res_est.update({res | length | string: 'seccion'}) %}{% set _ = res.append(['2. Privilegios sudo', 'Cuentas', 'Qué significa']) %}
{%- set _ = res.append(['Sudo total (ALL)', t.tot, 'Pueden ejecutar cualquier comando como root. Se divide en:']) %}
{%- set _ = res.append(['     sin pedir contraseña (NOPASSWD)', t.np, 'Es el mayor riesgo: quien entre a la cuenta es root de inmediato.']) %}
{%- set _ = res.append(['     pidiendo su propia contraseña', t.pr, 'Es la administración normal: debe escribir su contraseña.']) %}
{%- set _ = res.append(['     pidiendo la contraseña de root', t.rt, 'Es la regla por defecto de SUSE (targetpw): solo la usa quien ya conoce la clave de root.']) %}
{%- set _ = res.append(['Sudo limitado', t.lim, 'Solo comandos puntuales, como los perfiles auditor o soporte (hoja Sudo).']) %}
{%- set _ = res.append(['Sin sudo', t.u - t.tot - t.lim, 'No pueden ejecutar nada como root.']) %}
{%- set _ = res.append(['', '', '']) %}
{%- set _ = res_est.update({res | length | string: 'seccion'}) %}{% set _ = res.append(['3. Hallazgos por severidad', 'Casos', 'Qué hacer']) %}
{%- for s in ['CRITICO', 'ALTO', 'MEDIO', 'BAJO', 'INFO'] %}{% set _ = res.append([sev_txt[s], conteo[s], auditoria_severidades[s]]) %}{% endfor %}
{%- set _ = res.append(['Total', hall | length, 'La hoja "Tipos de hallazgo" explica cada problema y qué hacer; la hoja "Hallazgos" los lista uno por uno.']) %}
{%- set _ = res.append(['', '', '']) %}
{%- set _ = res_est.update({res | length | string: 'seccion'}) %}{% set _ = res.append(['4. Preparar el cambio masivo de contraseña (2b, UID ' ~ auditoria_uid_minimo ~ ' o mayor)', 'Cuentas', 'Qué significa y qué hacer']) %}
{%- set _ = res.append(['Se les forzaría el cambio', t.fz, 'El cambio masivo les pediría una contraseña nueva en el próximo ingreso. Antes, revise las que no parecen de una persona:']) %}
{%- for r_ in [[REVISAR, 'Tienen indicios de servicio, aplicación o automatización (nombre genérico, terminado en número, descripción de servicio o uso de llave). Si lo son, agréguelas a cuentas_servicio.'],
               [CONFIRMAR, 'No tienen descripción: confirme a quién pertenecen.'],
               [APLICAR, 'Parecen cuentas de personas: el cambio se les puede aplicar.']] %}
{%-   set _ = res.append(['     ' ~ r_[0], rec_cuenta.get(r_[0], 0), r_[1] ~ ' (' ~ (rec_usuarios.get(r_[0], {}) | length) ~ ' usuarios)']) %}
{%- endfor %}
{%- set _ = res.append(['No se les forzaría', t.u - t.fz, 'El sistema las omite solo, por uno de estos motivos:']) %}
{%- for m in motivos | dictsort(by='value') | reverse %}
{%-   set exp = [] %}{% for p in motivo_exp if m[0].startswith(p[0]) and not exp %}{% set _ = exp.append(p[1]) %}{% endfor %}
{%-   set _ = res.append(['     ' ~ m[0], m[1], exp | first | default('')]) %}
{%- endfor %}
{%- set _ = res.append(['Pasos', '', '1) En la hoja «Plan forzar cambio contraseña», filtre la columna Recomendación por REVISAR y CONFIRMAR.  2) Las que sean de aplicaciones o automatizaciones, agréguelas a cuentas_servicio en vars/comunes.yml.  3) Vuelva a auditar y confirme que pasan a EXCLUIDA.  4) Lance la 2b con «todos_uid_1000».']) %}
{%- set _ = res.append(['', '', '']) %}
{%- set _ = res_est.update({res | length | string: 'seccion'}) %}{% set _ = res.append(['5. Cómo leer este informe', '', 'Qué contiene cada hoja']) %}
{%- set _ = res.append(['Tipos de hallazgo', '', 'Empiece aquí. Cada problema encontrado con lo que significa, qué hacer y en cuántos servidores y cuentas aparece.']) %}
{%- set _ = res.append(['Usuarios', '', 'Una fila por usuario: en cuántos servidores existe y puede entrar, su último acceso, su hallazgo más grave, su sudo y el estado de su contraseña.']) %}
{%- set _ = res.append(['Plan forzar cambio contraseña', '', 'Prepara el cambio masivo: por usuario, los servidores donde SÍ se le forzaría y los de NO, con la justificación, los indicios de cuenta de servicio y una recomendación (REVISAR, CONFIRMAR, APLICAR, EXCLUIDA).']) %}
{%- set _ = res.append(['Servidores', '', 'Una fila por servidor: cuentas, sudo, estado de root, configuración de SSH y los servidores que no respondieron.']) %}
{%- set _ = res.append(['Sudo', '', 'Cada cuenta con sudo: qué puede ejecutar, qué contraseña le pide y de qué regla sale.']) %}
{%- set _ = res.append(['Hallazgos', '', 'Todos los hallazgos, uno por fila, del más grave al menos grave.']) %}
{%- set _ = res.append(['Detalle', '', 'Toda la información de cada cuenta en cada servidor.']) %}
{%- if aud_cambio | bool %}{% set _ = res.append(['No encontradas', '', 'Cuentas del cambio que no existen en algún servidor.']) %}{% endif %}
{%- set _ = res.append(['Consejo', '', 'Todas las hojas tienen filtros en la fila de títulos. Esa fila (y en Detalle, las dos primeras columnas) queda fija al desplazarse.']) %}
{#- ---------------------------------------------------------------- Hojas -#}
{%- set hall_filas = [] %}{% for x in hall | sort(attribute='0') %}{% set _ = hall_filas.append(x[1:]) %}{% endfor %}
{%- set tipos_hoja = [] %}{% for x in tipos_filas %}{% set _ = tipos_hoja.append(x[2:]) %}{% endfor %}
{%- set c_sev = {'Severidad': sev_color, 'Severidad máxima': sev_color, 'Hallazgo más grave en sus servidores': sev_color} %}
{%- set hojas = [
      {'nombre': 'Resumen', 'encabezados': [], 'filas': res, 'estilos_fila': res_est, 'ajustar': [2], 'anchos': [48, 12, 100],
       'colores': {'0': sev_color}},
      {'nombre': 'Tipos de hallazgo', 'encabezados': ['Severidad', 'Tipo', 'Qué significa', 'Qué se recomienda', 'Casos', 'Servidores', 'Cuentas distintas'],
       'filas': tipos_hoja, 'vacia': 'Sin hallazgos.', 'anchos': [11, 26, 60, 55, 9, 11, 11], 'ajustar': [2, 3], 'colores': c_sev},
