      "required": true,
      "type": "multiplechoice",
      "variable": "crear_origen",
      "min": 0,
      "max": 1024,
      "default": "encuesta",
      "choices": [
        "encuesta",
        "catalogo"
      ],
      "new_question": true
    },
    {
      "question_name": "Usuarios (si origen = encuesta)",
