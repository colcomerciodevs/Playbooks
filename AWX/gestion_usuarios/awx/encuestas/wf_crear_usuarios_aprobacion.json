{
  "name": "USUARIOS | WF - Crear usuarios",
  "description": "Aprobación -> creación de usuarios -> auditoría de verificación.",
  "spec": [
    {
      "question_name": "Ticket o justificación",
      "question_description": "Número de ticket o RFC y motivo del cambio. Es lo primero que revisa quien aprueba.",
      "required": true,
      "type": "text",
      "variable": "ticket_cambio",
      "min": 3,
      "max": 300,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Servidores o grupo del inventario",
      "question_description": "Grupo, servidor o patrón del inventario. No se permite localhost. Ejemplos: GEOPOS · PPU · srv1,srv2 · GEOPOS:!srv1",
      "required": true,
      "type": "text",
      "variable": "objetivo",
      "min": 1,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Método de acceso",
      "question_description": "[contrasena] La cuenta entra con la contraseña inicial. [llave] Entra solo con llave SSH (sin contraseña).",
      "required": true,
      "type": "multiplechoice",
      "variable": "crear_metodo_acceso",
      "min": 0,
      "max": 1024,
      "default": "contrasena",
      "choices": [
        "contrasena",
        "llave"
      ],
      "new_question": true
    },
    {
      "question_name": "Origen de la lista de usuarios",
