      "required": false,
      "type": "multiplechoice",
      "variable": "crear_catalogo",
      "min": 0,
      "max": 1024,
      "default": "",
      "choices": [
        "usuarios_generales",
        "admins_linux",
        "cuentas_de_servicio",
        "soporte_zona_norte",
        "soporte_zona_centro"
