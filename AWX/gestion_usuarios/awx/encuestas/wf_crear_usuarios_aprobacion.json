      "new_question": true
    },
    {
      "question_name": "Grupos secundarios",
      "question_description": "Separados por coma. Solo se agregan si ya existen en el servidor. No se permiten grupos privilegiados (wheel, sudo, root, docker…).",
      "required": false,
      "type": "text",
      "variable": "crear_grupos_secundarios",
      "min": 0,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
