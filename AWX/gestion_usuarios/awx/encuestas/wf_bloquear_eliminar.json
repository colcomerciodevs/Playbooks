{
  "name": "USUARIOS | WF - Bloquear o eliminar",
  "description": "Aprobación -> bloqueo, reactivación o eliminación -> auditoría de verificación.",
  "spec": [
    {
      "question_name": "Ticket o justificación",
      "question_description": "Número de ticket o RFC y motivo del cambio. Es lo primero que revisa quien aprueba.",
      "required": true,
      "type": "text",
      "variable": "ticket_cambio",
      "min": 3,
      "max": 300,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Servidores o grupo del inventario",
      "question_description": "Grupo, servidor o patrón del inventario. No se permite localhost. Ejemplos: GEOPOS · PPU · srv1,srv2 · GEOPOS:!srv1",
      "required": true,
      "type": "text",
      "variable": "objetivo",
      "min": 1,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Usuario(s)",
      "question_description": "Separados por coma. No se aceptan cuentas críticas.",
      "required": true,
      "type": "text",
      "variable": "eliminar_usuarios",
      "min": 1,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Acción",
      "question_description": "[bloquear] Impide el ingreso y conserva el home (reversible). [reactivar] Revierte el bloqueo. [eliminar] Borra la cuenta y su home.",
      "required": true,
      "type": "multiplechoice",
      "variable": "eliminar_accion",
      "min": 0,
      "max": 1024,
      "default": "bloquear",
      "choices": [
        "bloquear",
        "reactivar",
        "eliminar"
      ],
      "new_question": true
    },
    {
      "question_name": "Respaldar home antes de eliminar",
      "question_description": "[SI] Antes de eliminar, comprime el home en /var/backups/usuarios_eliminados/.",
      "required": true,
      "type": "multiplechoice",
      "variable": "eliminar_respaldar_home",
      "min": 0,
      "max": 1024,
      "default": "SI",
      "choices": [
        "SI",
        "NO"
      ],
      "new_question": true
    },
    {
      "question_name": "Confirmación (solo para eliminar)",
      "question_description": "Solo para eliminar: escriba CONFIRMAR.",
      "required": false,
      "type": "text",
      "variable": "eliminar_confirmacion",
      "min": 0,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    }
  ]
}
