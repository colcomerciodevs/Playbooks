      "type": "text",
      "variable": "ticket_cambio",
      "min": 3,
      "max": 300,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Servidores o grupo del inventario",
      "question_description": "Grupo, servidor o patrón del inventario. No se permite localhost. Ejemplos: GEOPOS · PPU · srv1,srv2 · GEOPOS:!srv1",
