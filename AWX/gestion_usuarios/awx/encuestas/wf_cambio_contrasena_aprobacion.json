{
  "name": "USUARIOS | WF - Cambio de contraseña",
  "description": "Aprobación -> cambio de contraseña -> auditoría de verificación.",
  "spec": [
    {
      "question_name": "Ticket o justificación",
      "question_description": "Número de ticket / RFC y motivo del cambio. Es lo primero que revisa quien aprueba.",
      "required": true,
      "type": "text",
      "variable": "ticket_cambio",
      "min": 3,
      "max": 300,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Servidores o grupo del inventario",
      "question_description": "Grupo (ej. GEOPOS, PPU, OCI_PEOPLE_PRD), servidor, o patrón Ansible: grupo1:grupo2, grupo:!servidor, srv1,srv2.",
      "required": true,
      "type": "text",
      "variable": "objetivo",
      "min": 1,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Usuario(s)",
      "question_description": "Uno o varios separados por coma. Ej: jperez  o  jperez,soporte1",
      "required": true,
      "type": "text",
      "variable": "contrasena_usuarios",
      "min": 1,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Confirmación para cuenta crítica",
      "question_description": "Solo para root, tux, adminso y otras cuentas administradoras: escriba CONFIRMAR. No se permite con objetivo all.",
      "required": false,
      "type": "text",
      "variable": "contrasena_confirmar_critica",
      "min": 0,
      "max": 1024,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Nueva contraseña",
      "question_description": "AWX la guarda cifrada y no aparece en la salida del job.",
      "required": true,
      "type": "password",
      "variable": "contrasena_nueva",
      "min": 8,
      "max": 128,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Confirmar contraseña",
      "question_description": "Debe coincidir con la anterior.",
      "required": true,
      "type": "password",
      "variable": "contrasena_confirmacion",
      "min": 8,
      "max": 128,
      "default": "",
      "choices": [],
      "new_question": true
    },
    {
      "question_name": "Contraseña sin caducidad (nunca expira)",
      "question_description": "SI: chage -m 0 -M 99999 -I -1. Para cuentas críticas que el hardening haría caducar; requiere \"Forzar cambio\" en NO. NO: conserva la política actual.",
      "required": true,
      "type": "multiplechoice",
      "variable": "contrasena_nunca_caduca",
      "min": 0,
      "max": 1024,
      "default": "NO",
      "choices": [
        "SI",
        "NO"
      ],
      "new_question": true
    },
    {
      "question_name": "Forzar cambio en el próximo inicio de sesión",
      "question_description": "Recomendado SI para cuentas personales. Excluyente con \"sin caducidad\". En cuentas críticas debe ser NO.",
      "required": true,
      "type": "multiplechoice",
      "variable": "contrasena_forzar_cambio",
      "min": 0,
      "max": 1024,
      "default": "SI",
      "choices": [
        "SI",
        "NO"
      ],
      "new_question": true
    },
    {
      "question_name": "Desbloquear la cuenta",
      "question_description": "Reinicia intentos fallidos (faillock/pam_tally2) y quita una expiración de cuenta ya vencida. También revierte un bloqueo hecho con la opción 4.",
      "required": true,
      "type": "multiplechoice",
      "variable": "contrasena_desbloquear",
      "min": 0,
      "max": 1024,
      "default": "NO",
      "choices": [
        "SI",
        "NO"
      ],
      "new_question": true
    }
  ]
}
